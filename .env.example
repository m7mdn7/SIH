# Application Ports
API_PORT=4000
WEB_PORT=5173
AI_SERVICE_PORT=8000

# Database Configuration (PostgreSQL / pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=siip
DB_PASSWORD=siip_dev
DB_NAME=siip
DATABASE_URL=postgresql://siip:siip_dev@localhost:5432/siip

# Database Fallback Configuration (SQLite)
# Set to 'true' to force SQLite even if Postgres is available
USE_SQLITE=true
SQLITE_DB_PATH=../../siip.db

# JWT Secrets
JWT_SECRET=supersecret_jwt_key_for_hackathon

# AI Service URL
AI_SERVICE_URL=http://localhost:8000
